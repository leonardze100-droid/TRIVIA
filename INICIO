        function handleSearch(query) {
            const term = query.toLowerCase().trim();
            if (!term) {
                searchAlert.classList.add('hidden');
                articleItems.forEach(el => el.style.display = 'block');
                articleSections.forEach(el => el.style.display = 'block');
                return;
            }

            let matchCount = 0;
            articleItems.forEach(item => {
                const text = item.textContent.toLowerCase();
                const keywords = item.getAttribute('data-keywords') || '';
                if (text.includes(term) || keywords.includes(term)) {
                    item.style.display = 'block';
                    matchCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Hide sections if all items inside are hidden
            articleSections.forEach(section => {
                const visibleItems = section.querySelectorAll('.article-item[style*="display: block"], .article-item:not([style*="display: none"])');
                // If section has annexes or title matching
                const sectionText = section.textContent.toLowerCase();
                if (sectionText.includes(term) || visibleItems.length > 0) {
                    section.style.display = 'block';
                } else {
                    section.style.display = 'none';
                }
            });

            searchAlert.classList.remove('hidden');
            searchCountText.textContent = `Resultados para "${query}": ${matchCount} elementos encontrados.`;
        }

        globalSearch.addEventListener('input', (e) => {
            mobileSearch.value = e.target.value;
            handleSearch(e.target.value);
        });

        mobileSearch.addEventListener('input', (e) => {
            globalSearch.value = e.target.value;
            handleSearch(e.target.value);
        });

        clearSearchBtn.addEventListener('click', () => {
            globalSearch.value = '';
            mobileSearch.value = '';
            handleSearch('');
        });

        // Active Navigation Highlight on Scroll
        const observerOptions = {
            root: null,
            rootMargin: '-20% 0px -70% 0px',
            threshold: 0
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const id = entry.target.getAttribute('id');
                    navItems.forEach(nav => {
                        nav.classList.remove('bg-indigo-50', 'dark:bg-slate-700/50', 'text-indigo-600', 'dark:text-indigo-400', 'font-semibold');
                        if (nav.getAttribute('href') === `#${id}`) {
                            nav.classList.add('bg-indigo-50', 'dark:bg-slate-700/50', 'text-indigo-600', 'dark:text-indigo-400', 'font-semibold');
                        }
                    });
                }
            });
        }, observerOptions);

        articleSections.forEach(section => {
            observer.observe(section);
        });
    </script>
</body>
</html>
