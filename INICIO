                <div id="capitulo-1" class="article-section bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-3xl p-6 sm:p-8 shadow-sm">
                    <div class="flex items-center space-x-3 mb-6 pb-4 border-b border-slate-100 dark:border-slate-700">
